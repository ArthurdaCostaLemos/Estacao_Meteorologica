{
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "*/.", "*/node_modules/*"],
    "headers": [
      {
        "source": "/@(config|app).js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "/style.css",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=3600" }
        ]
      }
    ]
  }
}